{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifilot.github.io/qasr/schemas/faces.schema.json",
  "title": "QASR polygon faces version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "faces"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "$schema": {
      "type": "string"
    },
    "faces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vertices": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000000.0,
                "maximum": 1000000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 3,
            "maxItems": 64
          },
          "coordinates": {
            "enum": [
              "cartesian",
              "fractional"
            ]
          },
          "atom_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999
            },
            "minItems": 3,
            "maxItems": 64
          },
          "cell_offsets": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -1024,
                "maximum": 1024
              },
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 3,
            "maxItems": 64
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
          },
          "outline_color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
          },
          "outline_width": {
            "type": "number",
            "minimum": 0,
            "maximum": 8
          },
          "repeat": {
            "type": "boolean"
          }
        },
        "oneOf": [
          {
            "required": [
              "vertices"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "atom_indices"
                  ]
                },
                {
                  "required": [
                    "cell_offsets"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "atom_indices"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "vertices"
                  ]
                },
                {
                  "required": [
                    "coordinates"
                  ]
                }
              ]
            }
          }
        ]
      },
      "maxItems": 4096
    }
  }
}
