{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifilot.github.io/qasr/schemas/worker.schema.json",
  "title": "QASR sequential worker request version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[ -~]{1,128}$"
    },
    "op": {
      "enum": [
        "render",
        "validate",
        "stats",
        "clear_cache"
      ]
    },
    "job": {
      "title": "QASR invocation schema version 1",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "$schema": {
          "type": "string"
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "-"
          }
        },
        "report": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "oneOf": [
            {
              "const": "final"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999999
            }
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "auto",
            "poscar",
            "contcar",
            "outcar",
            "xml",
            "xyz",
            "extxyz",
            "gaussian-input",
            "gaussian-output",
            "gjf",
            "com",
            "ams"
          ]
        },
        "threads": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          ]
        },
        "recover": {
          "type": "boolean"
        },
        "json_errors": {
          "type": "boolean"
        },
        "no_user_config": {
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": 1
            },
            "$schema": {
              "type": "string"
            },
            "image": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16384
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16384
                },
                "background": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                },
                "style": {
                  "type": "string",
                  "enum": [
                    "shaded",
                    "illustrated",
                    "ortep",
                    "balsac"
                  ]
                },
                "tone": {
                  "type": "string",
                  "enum": ["color", "monocolor", "dualtone"],
                  "description": "Dithered atom/bond tones for ortep and balsac; color preserves the style palette."
                },
                "aa": {
                  "type": "string",
                  "enum": [
                    "native",
                    "2x",
                    "4x",
                    "adaptive"
                  ]
                },
                "backend": {
                  "type": "string",
                  "enum": [
                    "zbuffer",
                    "cairo"
                  ]
                },
                "depth_fade": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "outline_width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 8
                },
                "png_encoder": {
                  "type": "string",
                  "enum": [
                    "libpng",
                    "libdeflate",
                    "cairo"
                  ]
                },
                "png_filter": {
                  "type": "string",
                  "enum": [
                    "none",
                    "sub",
                    "up",
                    "adaptive"
                  ]
                },
                "png_compression": {
                  "oneOf": [
                    {
                      "const": "auto"
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "camera": {
              "type": "object",
              "properties": {
                "projection": {
                  "const": "orthographic"
                },
                "view": {
                  "oneOf": [
                    {
                      "const": "top"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  ]
                },
                "up": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "margin": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 0.5
                }
              },
              "additionalProperties": false
            },
            "geometry": {
              "type": "object",
              "properties": {
                "repeat": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "expand_xy": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "image_colors": {
                  "type": "string",
                  "enum": [
                    "normal",
                    "muted",
                    "greyscale"
                  ]
                },
                "sphere_scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "bond_radius_A": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "elements": {
