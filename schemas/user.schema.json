      "properties": {
        "cell": {
          "type": "boolean"
        },
        "cell_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 32
        },
        "labels": {
          "type": "string",
          "enum": [
            "none",
            "element",
            "index"
          ]
        },
        "axes": {
          "type": "boolean"
        },
        "legend": {
          "type": "boolean"
        },
        "scale_bar": {
          "type": "boolean"
        },
        "cell_style": {
          "enum": [
            "solid",
            "dashed"
          ]
        },
        "cell_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "cell_outline_width": {
          "type": "number",
          "minimum": 0,
          "maximum": 8,
          "description": "White contrast contour width per side in output pixels; zero disables it."
        },
        "cell_dash_length": {
          "type": "number",
          "minimum": 1,
          "maximum": 256,
          "description": "Dash length in output pixels; default 8."
        },
        "cell_dash_gap": {
          "type": "number",
          "minimum": 1,
          "maximum": 256,
          "description": "Gap between dashes in output pixels; default 5."
        }
      },
      "additionalProperties": false
    },
